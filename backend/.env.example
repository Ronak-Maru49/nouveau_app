MONGODB_URI=mongodb://localhost:27017/nouveau_app
PORT=5000

# Razorpay: keep the secret server-side and never commit .env.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_secret_key

# Optional: set these to send order bills automatically from the backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
